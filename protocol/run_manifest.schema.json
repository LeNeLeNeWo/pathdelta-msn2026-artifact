{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/pathdelta/run-manifest-v1.schema.json",
  "title": "PathDelta run manifest",
  "type": "object",
  "required": [
    "schema_version",
    "run_id",
    "purpose",
    "protocol",
    "sources",
    "seed",
    "software",
    "model",
    "backends",
    "metrics",
    "inputs",
    "outputs",
    "created_at"
  ],
  "properties": {
    "schema_version": {"const": "pathdelta.run_manifest.v1"},
    "run_id": {"type": "string", "minLength": 1},
    "purpose": {"enum": ["registered", "holdout", "developmental", "smoke", "replication"]},
    "protocol": {
      "type": "object",
      "required": ["id", "version", "status", "aggregate_sha256"],
      "properties": {
        "id": {"const": "pathdelta-protocol"},
        "version": {"type": "string", "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+$"},
        "status": {"enum": ["frozen", "developmental", "replication"]},
        "aggregate_sha256": {"$ref": "#/$defs/sha256"}
      },
      "additionalProperties": true
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "uri", "revision", "content_sha256"],
        "properties": {
          "name": {"type": "string"},
          "uri": {"type": "string"},
          "revision": {"type": "string"},
          "retrieved_at": {"type": "string", "format": "date-time"},
          "content_sha256": {"$ref": "#/$defs/sha256"}
        },
        "additionalProperties": true
      }
    },
    "seed": {
      "type": "object",
      "additionalProperties": {"type": "integer"}
    },
    "software": {"type": "object"},
    "model": {
      "type": "object",
      "required": ["backend", "configured_model", "secret_values_recorded"],
      "properties": {
        "backend": {"type": "string"},
        "configured_model": {"type": "string"},
        "secret_values_recorded": {"const": false}
      },
      "additionalProperties": true
    },
    "backends": {"type": "object"},
    "metrics": {
      "type": "object",
      "required": ["llm_calls", "backend_attempts", "retries", "token_usage", "latency_ms"],
      "properties": {
        "llm_calls": {"type": "integer", "minimum": 0},
        "backend_attempts": {"type": "integer", "minimum": 0},
        "retries": {"type": "integer", "minimum": 0},
        "token_usage": {
          "type": "object",
          "required": ["prompt", "completion", "total"],
          "properties": {
            "prompt": {"type": "integer", "minimum": 0},
            "completion": {"type": "integer", "minimum": 0},
            "total": {"type": "integer", "minimum": 0}
          }
        },
        "latency_ms": {"type": "object"}
      },
      "additionalProperties": true
    },
    "inputs": {"type": "array", "items": {"$ref": "#/$defs/artifact"}},
    "outputs": {"type": "array", "items": {"$ref": "#/$defs/artifact"}},
    "created_at": {"type": "string", "format": "date-time"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "artifact": {
      "type": "object",
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string"},
        "role": {"type": "string"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "bytes": {"type": "integer", "minimum": 0}
      }
    }
  },
  "additionalProperties": true
}
