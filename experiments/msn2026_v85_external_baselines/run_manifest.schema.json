{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pathdelta.local/schemas/msn2026-v85-run-manifest.json",
  "title": "PathDelta MSN2026 v8.5 external baseline run manifest",
  "type": "object",
  "required": [
    "schema_version", "run_id", "created_at", "status", "stage", "methods",
    "dataset", "protocol", "model", "budgets", "environment", "integrity"
  ],
  "properties": {
    "schema_version": {"const": "msn2026-v85-run-manifest-1.0"},
    "run_id": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "format": "date-time"},
    "status": {"enum": ["frozen", "running", "complete", "failed"]},
    "stage": {"enum": ["smoke", "pilot", "confirmatory", "sensitivity"]},
    "methods": {
      "type": "array", "minItems": 4, "uniqueItems": true,
      "items": {"enum": [
        "llm_netcfg_adapted", "inta_adapted", "cosynth_vpp_adapted",
        "cornetto_agentic_adapted", "pathdelta_fullr"
      ]}
    },
    "dataset": {
      "type": "object",
      "required": ["root", "split_path", "split_sha256", "case_count", "source_manifest_sha256"]
    },
    "protocol": {
      "type": "object",
      "required": ["path", "sha256", "adaptation_claim"]
    },
    "model": {
      "type": "object",
      "required": ["backend_env", "model_env", "temperature", "seed_support"]
    },
    "budgets": {
      "type": "object",
      "required": [
        "max_logical_llm_calls", "max_completion_tokens_per_call",
        "max_completion_tokens_per_case"
      ]
    },
    "environment": {"type": "object"},
    "integrity": {"type": "object"}
  },
  "additionalProperties": true
}
